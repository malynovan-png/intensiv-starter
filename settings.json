{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Read(./**)",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "mcp__dashi-channel",
      "mcp__dashi-channel__reply",
      "mcp__dashi-channel__react",
      "mcp__dashi-channel__edit_message",
      "mcp__dashi-channel__download_attachment",
      "mcp__dashi-channel__status",
      "WebFetch",
      "WebSearch",
      "Bash(git *)",
      "Bash(bun *)",
      "Bash(npm *)",
      "Bash(node *)",
      "Bash(python3 *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(mkdir *)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(curl * | bash)",
      "Bash(wget * | bash)",
      "Bash(sudo *)",
      "Bash(git push --force*)"
    ],
    "additionalDirectories": [
      "."
    ]
  }
}
